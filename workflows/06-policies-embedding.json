{
  "name": "WF6 — Policies → vector store",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "wf6-trigger",
      "name": "Execute Manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-280, 0],
      "parameters": {}
    },
    {
      "id": "wf6-list",
      "name": "List Policy Files",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [-60, 0],
      "parameters": {
        "resource": "fileFolder",
        "searchMethod": "query",
        "queryString": "",
        "returnAll": true,
        "filter": {
          "folderId": { "__rl": true, "value": "REPLACE_WITH_POLICIES_FOLDER_ID", "mode": "id" },
          "whatToSearch": "files"
        },
        "options": {}
      },
      "credentials": { "googleDriveOAuth2Api": { "id": "drive-oauth", "name": "Drive OAuth" } }
    },
    {
      "id": "wf6-download",
      "name": "Download File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [160, 0],
      "parameters": {
        "operation": "download",
        "fileId": { "__rl": true, "value": "={{ $json.id }}", "mode": "id" },
        "options": { "binaryPropertyName": "data" }
      },
      "credentials": { "googleDriveOAuth2Api": { "id": "drive-oauth", "name": "Drive OAuth" } }
    },
    {
      "id": "wf6-extract",
      "name": "Markdown To Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [380, 0],
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "data",
        "options": { "destinationKey": "content" }
      }
    },
    {
      "id": "wf6-store",
      "name": "Policies Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.1,
      "position": [600, 0],
      "parameters": {
        "mode": "insert",
        "memoryKey": "policies",
        "clearStore": true
      }
    },
    {
      "id": "wf6-embeddings",
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [480, 220],
      "parameters": { "model": "baai/bge-m3", "options": {} },
      "credentials": { "openAiApi": { "id": "embeddings-api", "name": "Embeddings API" } }
    },
    {
      "id": "wf6-loader",
      "name": "Document Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [700, 220],
      "parameters": {
        "dataType": "json",
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.content }}",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              { "name": "source", "value": "={{ $json.name }}" },
              { "name": "collection", "value": "policies" }
            ]
          }
        }
      }
    },
    {
      "id": "wf6-splitter",
      "name": "Text Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [700, 440],
      "parameters": { "chunkSize": 800, "chunkOverlap": 100, "options": {} }
    }
  ],
  "connections": {
    "Execute Manually":  { "main": [[{ "node": "List Policy Files", "type": "main", "index": 0 }]] },
    "List Policy Files": { "main": [[{ "node": "Download File", "type": "main", "index": 0 }]] },
    "Download File":     { "main": [[{ "node": "Markdown To Text", "type": "main", "index": 0 }]] },
    "Markdown To Text":  { "main": [[{ "node": "Policies Vector Store", "type": "main", "index": 0 }]] },
    "Embeddings":        { "ai_embedding": [[{ "node": "Policies Vector Store", "type": "ai_embedding", "index": 0 }]] },
    "Document Loader":   { "ai_document": [[{ "node": "Policies Vector Store", "type": "ai_document", "index": 0 }]] },
    "Text Splitter":     { "ai_textSplitter": [[{ "node": "Document Loader", "type": "ai_textSplitter", "index": 0 }]] }
  },
  "pinData": {}
}
