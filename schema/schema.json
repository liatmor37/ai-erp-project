          "name": "Name",
          "type": "text",
          "required": true
        },
        {
          "name": "Email",
          "type": "email"
        },
        {
          "name": "Phone",
          "type": "phone"
        },
        {
          "name": "Company",
          "type": "text"
        },
        {
          "name": "BusinessNumber",
          "type": "text"
        },
        {
          "name": "Address",
