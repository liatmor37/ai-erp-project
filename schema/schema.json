        },
        {
          "name": "City",
          "type": "text"
        },
        {
          "name": "Status",
          "type": "select",
          "choices": [
            "Active",
            "Inactive"
          ]
        },
        {
          "name": "Notes",
          "type": "longtext"
        },
        {
          "name": "Created",
          "type": "created"
        }
      ]
    },
